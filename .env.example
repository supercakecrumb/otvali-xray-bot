# Legacy bot and Finland connection. Replace placeholders in private deployment
# configuration; never commit the resulting credentials.
TELEGRAM_TOKEN=replace-with-private-bot-token
DATABASE_URL=postgres://bot:replace-with-private-password@localhost:5432/otvali?sslmode=disable
SSH_KEY_PATH=/run/secrets/otvali_ssh_key
LOG_LEVEL=INFO
BOT_DISABLED_SERVER_IDS=3
# Optional public HTTPS installation guide, without credentials/query/fragment.
# When Mini App is enabled, this is also its inline launch URL; its exact
# HTTPS origin must be listed in MINIAPP_ALLOWED_ORIGINS.
VPN_HELP_URL=

# Stockholm pilot: disabled until every required value is configured.
REMNA_ENABLED=false
REMNA_BASE_URL=
REMNA_API_TOKEN=
REMNA_SQUAD_UUID=
REMNA_SUBSCRIPTION_ORIGIN=
# Comma-separated, explicitly approved numeric Telegram IDs.
REMNA_ALLOWED_TELEGRAM_IDS=
# 0 = no automatic expiry; 1..3660 = finite access days. Traffic is unlimited.
# Retrieval never renews or changes existing provider accounts.
REMNA_ACCESS_DAYS=0

# Optional Telegram Mini App API. No Docker host port is published; route the
# private container port through HTTPS Traefik only after endpoint verification.
MINIAPP_ENABLED=false
MINIAPP_PORT=8080
# Exact HTTPS origins only; no wildcard, paths or trailing slash.
MINIAPP_ALLOWED_ORIGINS=https://otvali.aurorass.art
