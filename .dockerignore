
# Exclude local secret material, history and runtime data from build contexts.
.git
**/.git
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.log
**/*.log
*.db
**/*.db
*.db-*
**/*.db-*
*.sqlite*
**/*.sqlite*
*.pem
*.key
id_rsa*
id_ed25519*
known_hosts
__pycache__
**/__pycache__
node_modules
**/node_modules
